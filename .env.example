# ===== Gemini =====
# Required. Get from https://aistudio.google.com/apikey
GEMINI_API_KEY="your_gemini_api_key"

# ===== App =====
APP_URL=docere-7.vercel.app

# ===== Toss Payments =====
# Server-side secret used to confirm payments. Required for /api/payment/confirm.
# Universal docs test key (no merchant account needed for development):
#   test_sk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# For live deployment, replace with your live secret key from app.tosspayments.com.
TOSS_SECRET_KEY="test_sk_docs_OaPz8L5KdmQXkzRz3y47BMw6"

# Client-side publishable key — exposed to the browser via Vite. Override the
# fallback test key (test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm) here.
VITE_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"

# ===== Vercel KV (quota + day-pass storage) =====
# Auto-injected by Vercel when a KV database is provisioned in the dashboard
# (Storage → Create → KV). Local dev falls back to an in-memory store, so these
# are only needed for production.
# KV_REST_API_URL="https://...kv.vercel-storage.com"
# KV_REST_API_TOKEN="..."
