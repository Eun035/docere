/ Trigger backend analysis\n  const handleAnalyze = async (customText?: string, customLocation?: string, customImage?: string, customMime?: string) => {\n    setIsLoading(true);\n    setErrorMessage(null);\n    setIsSaved(false);\n\n    const txt = customText !== undefined ? customText : inputText;\n    const loc = customLocation !== undefined ? customLocation : locationName;\n    const imgData = customImage !== undefined ? customImage : selectedImage;\n    const mimeType = customMime !== undefined ? customMime : imageMime;\n\n    try {\n      // Remove data URL prefix if uploading raw base64 to backend\n      let cleanBase64 = null;\n      if (imgData) {\n        cleanBase64 = imgData.split(\",\")[1] || imgData;\n      }\n\n      const response = await fetch(\"/api/analyze\", {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify({\n          text: txt,\n          image: cleanBase64,\n          imageMime: mimeType\n        }),\n      });\n\n      if (!response.ok) {\n        const errJson = await response.json();\n        throw new Error(errJson.error || \"\353\271\204\353\254\270 \355\225\264\354\204\235 \354\232\224\354\262\255\354\227\220 \354\213\244\355\214\250\355\225\230\354\230\200\354\212\265\353\213\210\353\213\244.\");\n      }\n\n      const result: AnalysisResult = await response.json();\n      setActiveAnalysis(result);\n\n      // Create a temporary history item structure\n      const tempItem: HistoryItem = {\n        id: \"temp_\" + Date.now(),\n        timestamp: new Date().toISOString(),\n        inputText: txt || \"\354\235\264\353\257\270\354\247\200 \353\266\204\354\204\235 \354\232\224\354\262\255\",\n        locationName: loc || \"\354\225\214 \354\210\230 \354\227\206\353\212\224 \354\204\261\354\247\200\",\n        result\n      };\n      setActiveHistoryItem(tempItem);"
