      replacement_content: "import { PresetInscription } from \"./types\";\n\nexport const PRESET_INSCRIPTIONS: PresetInscription[] = [\n  {\n    id: \"vatican-petrus\",\n    title: \"\354\204\261 \353\262\240\353\223\234\353\241\234 \353\214\200\354\204\261\353\213\271 \354\262\234\354\236\245 \355\231\251\352\270\210 \353\271\204\353\254\270\",\n    originalText: \"TV ES PETRVS ET SVPER HANC PETRAM AEDIFICABO ECCLESIAM MEAM ET TIBI DABO CLAVES REGNI CAELORVM\",\n    location: \"\354\204\261 \353\262\240\353\223\234\353\241\234 \353\214\200\354\204\261\353\213\271 \354\243\274 \354\240\234\353\213\250 \353\217\224 \355\225\230\353\213\250 \353\252\250\354\236\220\354\235\264\355\201\254\",\n    city: \"\353\241\234\353\247\210 \353\260\224\355\213\260\354\271\270 (Vatican City)\",\n    imageAlt: \"Vatican St. Peter\'s Dome inside view\",\n    imageUrl: \"https://images.unsplash.com/photo-1548625361-155de8c7f947?auto=format&fit=crop&q=80&w=800\",\n    description: \"\354\204\261 \353\262\240\353\223\234\353\241\234 \352\264\221\354\236\245\352\263\274 \353\214\200\354\204\261\353\213\271\354\235\230 \354\213\254\354\236\245\353\266\200\354\227\220 \354\232\270\353\240\244 \355\215\274\354\247\200\353\212\224 \353\247\210\355\203\234\354\230\244 \353\263\265\354\235\214\354\204\234 16\354\236\245 18-19\354\240\210 \352\265\254\354\240\210\354\236\205\353\213\210\353\213\244. \353\262\240\353\223\234\353\241\234(\353\260\230\354\204\235) \354\234\204\354\227\220 \352\265\220\355\232\214\353\245\274 \354\204\270\354\232\260\352\263\240 \355\225\230\353\212\230\353\202\230\353\235\274\354\235\230 \354\227\264\354\207\240\353\245\274 \354\243\274\352\262\240\353\213\244\353\212\224 \354\225\275\354\206\215\354\235\264 \354\203\210\352\262\250\354\240\270 \354\236\210\354\212\265\353\213\210\353\213\244.\"\n  },\n  {\n    id: \"florence-portal\",\n    title: \"\355\224\274\353\240\214\354\262\264 \353\221\220\354\230\244\353\252\250 \354\204\261\353\213\271 \354\240\225\353\254\270 \354\236\245\354\213\235\",\n    originalText: \"DOMINVS DEVS SABAOTH PLENI SVNT COELI ET TERRA GLORIA TVA\",\n    location: \"\354\202\260\355\203\200 \353\247\210\353\246\254\354\225\204 \353\215\270 \355\224\274\354\230\244\353\240\210 \353\214\200\354\204\261\353\213\271 \355\214\214\354\202\254\353\223\234 \353\260\217 \354\240\234\353\213\250 \354\203\201\353\266\200\",\n    city: \"\355\224\274\353\240\214\354\262\264 (Florence, Italy)\",\n    imageAlt: \"Florence Duomo exterior\",\n    imageUrl: \"https://images.unsplash.com/photo-1528114039593-4366cc08227d?auto=format&fit=crop&q=80&w=800\",\n    description: \"\352\260\200\355\206\250\353\246\255 \353\257\270\354\202\254\354\235\230 \352\261\260\353\243\251\355\225\230\354\213\234\353\217\204\353\213\244(Sanctus) \352\260\220\354\202\254\354\206\241 \352\265\254\354\240\210\354\235\264\353\251\260, \354\235\264\354\202\254\354\225\274\354\204\234 6\354\236\245 3\354\240\210\354\227\220 \352\270\260\354\233\220\354\235\204 \353\221\241\353\213\210\353\213\244. \354\230\250 \354\262\234\354\247\200\354\227\220 \352\260\200\353\223\235\355\225\234 \355\225\230\353\212\220\353\213\230\354\235\230 \354\230\201\352\264\221\354\235\204 \352\270\260\353\246\254\353\212\224 \354\260\254\353\257\270\352\260\200 \354\230\210\353\260\260\354\262\230 \354\236\205\352\265\254\354\227\220 \354\241\260\352\260\201\353\220\230\354\226\264 \354\236\210\354\212\265\353\213\210\353\213\244.\"\n  },\n  {\n    id: \"santiago-gate\",\n    title: \"\354\202\260\355\213\260\354\225\204\352\263\240 \354\230\201\352\264\221\354\235\230 \353\254\270 \354\225\204\354\271\230\",\n    originalText: \"EGO SVM IANVA EST EST EST ET SALVABITVR INGREDIETVR ET EGREDIETVR ET PASCVA INVENIET\",\n    location: \"\354\202\260\355\213\260\354\225\204\352\263\240 \353\215\260 \354\275\244\355\217\254\354\212\244\355\205\224\353\235\274 \353\214\200\354\204\261\353\213\271 \354\230\201\352\264\221\354\235\230 \353\254\270 (P\303\263rtico de la Gloria)\",\n    city: \"\354\202\260\355\213\260\354\225\204\352\263\240 (Santiago, Spain)\",\n    imageAlt: \"Santiago de Compostela Cathedral\",\n    imageUrl: \"https://images.unsplash.com/photo-1561054366-0775d78a873c?auto=format&fit=crop&q=80&w=800\",\n    description: \"\354\232\224\355\225\234\353\263\265\354\235\214 10\354\236\245 9\354\240\210 \353\247\220\354\224\200\354\234\274\353\241\234, \354\230\210\354\210\230\353\213\230\352\273\230\354\204\234 \'\353\202\230\353\212\224 \353\254\270\354\235\264\353\213\244. \353\210\204\352\265\254\353\223\240\354\247\200 \353\202\230\353\245\274 \355\206\265\355\225\230\354\227\254 \353\223\244\354\226\264\354\230\244\353\251\264 \352\265\254\354\233\220\354\235\204 \353\260\233\352\263\240, \353\223\234\353\202\230\353\223\244\353\251\260 \355\222\200\353\260\255\354\235\204 \354\260\276\354\225\204 \354\226\273\354\235\204 \352\262\203\354\235\264\353\213\244\'\353\235\274\352\263\240 \354\204\240\355\217\254\355\225\230\354\213\234\353\212\224 \354\225\274\352\263\240\353\263\264 \354\202\254\353\217\204\354\235\230 \354\210\234\353\241\200\352\270\270 \354\242\205\354\260\251\354\247\200 \353\271\204\353\254\270\354\236\205\353\213\210\353\213\244.\"\n  },\n  {\n    id: \"assisi-peace\",\n    title: \"\354\225\204\354\213\234\354\213\234 \354\204\261 \355\224\204\353\236\200\354\271\230\354\212\244\354\275\224 \354\204\261\353\213\271 \353\271\204\353\254\270\",\n    originalText: \"PAX ET BONVM\",\n    location: \"\354\204\261 \355\224\204\353\236\200\354\271\230\354\212\244\354\275\224 \353\260\224\354\213\244\353\246\254\354\271\264 \354\236\205\352\265\254 \353\260\217 \354\240\225\354\233\220 \354\240\200\355\203\235\",\n    city: \"\354\225\204\354\213\234\354\213\234 (Assisi, Italy)\",\n    imageAlt: \"Assisi Town\",\n    imageUrl: \"https://images.unsplash.com/photo-1616038242814-a6eac7845d88?auto=format&fit=crop&q=80&w=800\",\n    description: \"\355\217\211\355\231\224\354\235\230 \354\204\261\354\236\220 \354\227\220\354\232\260\354\240\234\353\213\210\354\230\244 \355\224\204\353\236\200\354\271\230\354\212\244\354\275\224\354\235\230 \353\254\270\354\236\245\354\235\264\354\236\220 \355\224\204\353\236\200\354\271\230\354\212\244\354\275\224 \354\210\230\353\217\204\355\232\214\354\235\230 \355\225\265\354\213\254 \354\230\201\354\204\261\354\235\264 \353\213\264\352\270\264 \352\270\260\353\217\204\353\254\270\354\236\205\353\213\210\353\213\244. \352\260\200\353\202\234\352\263\274 \352\262\270\354\206\220 \354\206\215\354\227\220\354\204\234 \355\224\274\354\226\264\353\202\230\353\212\224 \'\355\217\211\355\231\224\354\231\200 \354\204\240(\354\235\274)\'\354\235\204 \354\230\250 \354\204\270\354\203\201\354\235\204 \355\226\245\355\225\264 \353\271\225\353\213\210\353\213\244.\"\n  },\n  {\n    id: \"catacombs-sleep\",\n    title: \"\353\241\234\353\247\210 \355\214\220\355\205\214\354\230\250 \353\260\217 \354\271\264\355\203\200\354\275\244 \353\254\230\354\206\214\",\n    originalText: \"REQVIESCAT IN PACE\",\n    location: \"\353\241\234\353\247\210 \354\202\260 \354\271\274\353\246\254\354\212\244\355\206\240 \354\271\264\355\203\200\354\275\244\353\262\240 \354\247\200\355\225\230 \353\254\230\354\227\255\354\235\230 \353\254\230\353\271\204\",\n    city: \"\353\241\234\353\247\210 (Rome, Italy)\",\n    imageAlt: \"Rome Tomb Catacombs\",\n    imageUrl: \"https://images.unsplash.com/photo-1579783900882-c0d3dad7b119?auto=format&fit=crop&q=80&w=800\",\n    description: \"\354\240\204 \354\204\270\352\263\204 \352\260\200\355\206\250\353\246\255 \354\203\201\354\236\245 \354\230\210\354\213\235\352\263\274 \353\271\204\353\254\270\354\227\220 \354\203\210\352\262\250\354\247\200\353\212\224 \353\214\200\355\221\234\354\240\201\354\235\270 \353\235\274\355\213\264\354\226\264 \354\234\204\353\240\271\352\265\254\353\241\234 \'\354\243\274\353\213\230, \352\267\270\354\227\220\352\262\214 \354\230\201\354\233\220\355\225\234 \354\225\210\354\213\235\354\235\204 \354\243\274\354\206\214\354\204\234\' \352\270\260\353\217\204\354\235\230 \352\267\200\352\262\260\354\240\220\354\236\205\353\213\210\353\213\244. \354\230\244\353\212\230\353\202\240 \354\236\245\353\241\200 \353\254\270\352\265\254\354\235\270 \'R.I.P.\'\354\235\230 \352\270\260\354\233\220\354\236\205\353\213\210\353\213\244.\"\n  },\n  {\n    id: \"crucifix-inri\",\n    title: \"\354\213\255\354\236\220\352\260\200 \352\263\240\354\203\201 \354\243\204\355\214\250 (Titulus)\",\n    originalText: \"I N R I (IESVS NAZARENVS REX IVDAEORVM)\",\n    location: \"\354\234\240\353\237\275 \353\214\200\353\213\244\354\210\230 \354\240\234\353\213\250 \352\263\240\354\203\201 \353\230\220\353\212\224 \352\263\240\353\224\225 \354\240\225\353\254\270 \354\213\255\354\236\220\352\260\200 \354\203\201\353\213\250\",\n    city: \"\354\240\204 \354\234\240\353\237\275 \354\204\261\353\213\271 \352\263\265\355\206\265\",\n    imageAlt: \"Gothic Church Crucifixion Altarpiece\",\n    imageUrl: \"https://images.unsplash.com/photo-1478147427282-58a87a120781?auto=format&fit=crop&q=80&w=800\",\n    description: \"\354\230\210\354\210\230\353\213\230\354\235\264 \354\213\255\354\236\220\352\260\200 \354\262\230\355\230\225\354\235\204 \353\213\271\355\225\230\354\213\244 \353\225\214 \353\271\214\353\235\274\353\217\204 \354\236\245\353\217\205\354\227\220 \354\235\230\355\225\264 \355\236\210\353\270\214\353\246\254\354\226\264, \352\267\270\353\246\254\354\212\244\354\226\264, \353\235\274\355\213\264\354\226\264\353\241\234 \354\240\201\355\230\224\353\215\230 \354\243\204\355\214\250\354\227\220\354\204\234 \352\270\260\354\233\220\355\225\251\353\213\210\353\213\244. \'\354\234\240\353\213\244\354\235\270\353\223\244\354\235\230 \354\231\225 \353\202\230\354\236\220\353\240\233 \354\230\210\354\210\230\'\353\235\274\353\212\224 \352\265\254\354\233\220\354\202\254\354\235\230 \354\203\201\354\247\225\354\240\201 \352\263\240\353\260\261\354\235\264 \354\266\225\354\225\275\353\220\230\354\226\264 \354\236\210\354\212\265\353\213\210\353\213\244.\"\n  }\n];\n"
    }
