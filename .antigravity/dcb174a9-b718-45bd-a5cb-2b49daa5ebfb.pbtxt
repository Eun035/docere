        lines {
          text: "    description: \"\354\232\224\355\225\234\353\263\265\354\235\214 10\354\236\245 9\354\240\210 \353\247\220\354\224\200\354\234\274\353\241\234, \354\230\210\354\210\230\353\213\230\352\273\230\354\204\234 \'\353\202\230\353\212\224 \353\254\270\354\235\264\353\213\244. \353\210\204\352\265\254\353\223\240\354\247\200 \353\202\230\353\245\274 \355\206\265\355\225\230\354\227\254 \353\223\244\354\226\264\354\230\244\353\251\264 \352\265\254\354\233\220\354\235\204 \353\260\233\352\263\240, \353\223\234\353\202\230\353\223\244\353\251\260 \355\222\200\353\260\255\354\235\204 \354\260\276\354\225\204 \354\226\273\354\235\204 \352\262\203\354\235\264\353\213\244\'\353\235\274\352\263\240 \354\204\240\355\217\254\355\225\230\354\213\234\353\212\224 \354\225\274\352\263\240\353\263\264 \354\202\254\353\217\204\354\235\230 \354\210\234\353\241\200\352\270\270 \354\242\205\354\260\251\354\247\200 \353\271\204\353\254\270\354\236\205\353\213\210\353\213\244.\""
